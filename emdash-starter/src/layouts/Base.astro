---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Open Graph page type, e.g. "article" for blog posts */
	pageType?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content, pageType } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: pageType ?? "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<style is:global>
			:root{--heritage:#002e62;--heritage-2:#0b4589;--heritage-deep:#001b3a;--lime:#d0f600;--ink:#17294a;--muted:#5a6b86;--soft:#eef3f9;--line:#d4deeb;--white:#fff;--afont:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
			*{box-sizing:border-box}
			body{margin:0;font-family:var(--afont);color:var(--ink);background:var(--soft);line-height:1.7;-webkit-font-smoothing:antialiased}
			header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}
			header nav{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:22px;padding:12px 24px;flex-wrap:wrap}
			header nav .brand{margin-right:auto;display:inline-flex;align-items:center}
			header nav .brand svg{height:30px;width:auto;display:block}
			header nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px}
			header nav a:hover{color:var(--heritage)}
			main{max-width:820px;margin:0 auto;padding:30px 24px 72px}
			main>h1{color:var(--heritage);letter-spacing:-.4px}
			article>div:first-child{margin:0 0 20px}
			article img,article picture{display:block;width:100%;height:auto;border-radius:18px}
			article h1{font-size:clamp(26px,4vw,38px);color:var(--heritage);line-height:1.16;margin:18px 0 8px;letter-spacing:-.5px}
			article h2{font-size:23px;color:var(--heritage);margin:32px 0 10px;letter-spacing:-.2px}
			article h3{font-size:18px;color:var(--heritage);margin:22px 0 6px}
			article p{margin:0 0 16px;font-size:17px}
			article a{color:var(--heritage-2)}
			article strong{color:var(--heritage)}
			article time{display:inline-block;color:var(--muted);font-size:14px;margin-bottom:6px}
			article .byline{color:var(--muted);font-size:14px;margin:0 0 14px;font-weight:600}
			article ul,article ol{margin:0 0 16px;padding-left:22px}
			article li{margin:6px 0;font-size:17px}
			article blockquote{margin:0 0 16px;padding:10px 18px;border-left:4px solid var(--lime);background:#fff;border-radius:8px;color:var(--ink)}
			main>ul{list-style:none;padding:0;margin:22px 0 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:22px}
			main>ul>li{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(0,27,58,.06)}
			main>ul>li>a{display:block;text-decoration:none;color:inherit}
			main>ul>li img,main>ul>li picture{width:100%;height:190px;object-fit:cover;border-radius:0}
			main>ul>li h2{font-size:18px;color:var(--heritage);margin:0;padding:14px 16px 0;line-height:1.3}
			main>ul>li p{color:var(--muted);font-size:14px;padding:8px 16px 16px;margin:0}
			.site-foot{background:var(--heritage-deep);color:#c3d0e2;text-align:center;padding:24px;font-size:13px;margin-top:10px}
			.site-foot a{color:#fff;text-decoration:none}
		</style>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header>
			<nav>
				<a href="/" class="brand" aria-label={siteTitle}>
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								style="height:40px;width:auto;margin:-6px 0;display:block;"
							/>
						) : (
							<img src="/assets/img/arenka-logo.jpg" alt="Arenka Logistics" style="height:40px;width:auto;display:block">
						)
					}
				</a>
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))
				}
				<LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
		<footer class="site-foot">Copyright &copy; 2026 Arenka Logistics | <a href="/privasi">Kebijakan Privasi</a> &middot; <a href="/ketentuan">Ketentuan Layanan</a></footer>
		<script src="/assets/js/cookie-notice.js" defer></script>
	</body>
</html>
