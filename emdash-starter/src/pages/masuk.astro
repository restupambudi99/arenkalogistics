---
import { env } from "cloudflare:workers";
const siteUrl = "https://arenkalogistics.com/masuk";
const enabled = env.INDEXING_ENABLED === "true";
const wa = "6285216002219";
const waHref = "https://wa.me/" + wa + "?text=" + encodeURIComponent("Halo Arenka, saya mau akses akun / dashboard member.");
---
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>Masuk ke Akun Arenka | Arenka Logistics</title>
<meta name="description" content="Masuk ke akun Arenka Logistics untuk memantau Titip Beli, Titip Kirim, status gudang, dan pengiriman dalam satu dashboard." />
<link rel="canonical" href={siteUrl} />
<meta name="robots" content={enabled ? "index,follow" : "noindex"} />
<meta name="theme-color" content="#002e62" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" />
<style>
:root{
  --heritage:#002e62; --heritage-2:#0b4589; --heritage-deep:#001b3a;
  --lime:#d0f600; --ink:#17294a; --muted:#5a6b86; --soft:#eef3f9;
  --line:#d4deeb; --white:#ffffff; --font:"Inter","Segoe UI",Arial,sans-serif;
  --radius:18px; color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;font:400 16px/1.6 var(--font);color:var(--ink);background:var(--soft);-webkit-font-smoothing:antialiased}
a{color:inherit}
img,svg{max-width:100%}
.wrap{min-height:100vh;min-height:100dvh;display:grid;grid-template-columns:1.05fr 1fr}
/* promo panel */
.promo{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:40px 48px;color:#fff;background:radial-gradient(1200px 600px at 10% -10%,var(--heritage-2),transparent 60%),linear-gradient(160deg,var(--heritage) 0%,var(--heritage-deep) 100%);overflow:hidden}
.promo::after{content:"";position:absolute;right:-120px;bottom:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(208,246,0,.22),transparent 65%)}
.promo .brand-row{display:flex;align-items:center;gap:10px;position:relative;z-index:1}
.promo h2{position:relative;z-index:1;margin:0;font-size:clamp(26px,3vw,40px);line-height:1.12;font-weight:800;letter-spacing:-.5px;max-width:14ch}
.promo h2 .mark{color:var(--heritage);background:var(--lime);padding:.02em .2em;border-radius:6px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.promo p.lead{position:relative;z-index:1;margin:14px 0 0;color:#c3d0e2;max-width:40ch}
.promo ul{position:relative;z-index:1;list-style:none;margin:26px 0 0;padding:0;display:grid;gap:12px}
.promo li{display:flex;align-items:center;gap:10px;font-weight:600}
.promo li .dot{flex:none;width:26px;height:26px;border-radius:50%;background:var(--lime);color:var(--heritage);display:grid;place-items:center;font-weight:800}
.promo .foot{position:relative;z-index:1;color:#9fb2cc;font-size:13px}
/* form panel */
.panel{display:flex;align-items:center;justify-content:center;padding:40px 24px;background:var(--soft)}
.card{width:100%;max-width:430px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 18px 50px rgba(0,27,58,.10);padding:36px 34px}
.card .logo-m{display:none;margin:0 0 18px}
.card h1{margin:0;font-size:27px;font-weight:800;letter-spacing:-.4px;color:var(--heritage);line-height:1.2}
.card .sub{margin:10px 0 24px;color:var(--muted);font-size:15px}
.gbtn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;font:700 15px var(--font);color:var(--ink);cursor:pointer;transition:background .15s,border-color .15s}
.gbtn:hover{background:#f6f9fd;border-color:#bccbe0}
.divider{display:flex;align-items:center;gap:14px;margin:20px 0;color:var(--muted);font-size:13px}
.divider::before,.divider::after{content:"";height:1px;background:var(--line);flex:1}
label{display:block;font-weight:700;font-size:13.5px;margin:0 0 7px;color:var(--heritage)}
label .req{color:#e23b3b}
.field{position:relative;margin-bottom:16px}
.field input{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:12px;font:400 15px var(--font);color:var(--ink);background:#fff;transition:border-color .15s,box-shadow .15s}
.field input:focus{outline:none;border-color:var(--heritage-2);box-shadow:0 0 0 3px rgba(11,69,137,.14)}
.field .toggle{position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:transparent;cursor:pointer;padding:6px;color:var(--muted);line-height:0}
.row-end{display:flex;justify-content:flex-end;margin:-6px 0 18px}
.row-end a{font-size:13.5px;font-weight:600;color:var(--heritage-2);text-decoration:none}
.row-end a:hover{text-decoration:underline}
.submit{width:100%;padding:14px;border:0;border-radius:12px;background:var(--heritage);color:#fff;font:800 16px var(--font);cursor:pointer;transition:background .15s,opacity .15s}
.submit:hover{background:#013a7d}
.notice{display:none;margin:16px 0 0;padding:13px 14px;border-radius:12px;background:#fff7dd;border:1px solid #ecd98a;color:#6b5600;font-size:14px;line-height:1.5}
.notice.show{display:block}
.notice a{font-weight:700;color:var(--heritage)}
.alt{margin:22px 0 0;text-align:center;font-size:14.5px;color:var(--muted)}
.alt a{font-weight:700;color:var(--heritage);text-decoration:none}
.alt a:hover{text-decoration:underline}
.back{margin:18px 0 0;text-align:center;font-size:13.5px}
.back a{color:var(--muted);text-decoration:none}
.back a:hover{color:var(--heritage)}
@media (max-width:900px){
  .wrap{grid-template-columns:1fr}
  .promo{display:none}
  .panel{padding:28px 18px;min-height:100vh;min-height:100dvh}
  .card .logo-m{display:flex;justify-content:center}
}
</style>
</head>
<body>
<main class="wrap">
  <section class="promo">
    <div class="brand-row">
      <svg height="34" viewBox="0 0 172 40" role="img" aria-label="Arenka Logistics">
        <path d="M3 35L16.5 5h7.4L37.4 35h-7.6L20.2 13.4 10.6 35z" fill="#ffffff"/>
        <path d="M9.5 24.5h24.8l4.7 3.6-4.7 3.6H6.4z" fill="#d0f600"/>
        <text x="46" y="24" font-family="Inter,Arial,sans-serif" font-size="21" font-weight="800" letter-spacing="-.4" fill="#ffffff">ARENKA</text>
        <text x="47" y="35.5" font-family="Inter,Arial,sans-serif" font-size="7.4" font-weight="650" letter-spacing="2.9" fill="#c3d0e2">LOGISTICS</text>
      </svg>
    </div>
    <div>
      <h2>Satu akun untuk <span class="mark">impor dari China</span> tanpa ribet.</h2>
      <p class="lead">Pantau Titip Beli, Titip Kirim, status gudang, sampai pengiriman akhir dalam satu dashboard.</p>
      <ul>
        <li><span class="dot">&#10003;</span> Semua pesanan di satu tempat</li>
        <li><span class="dot">&#10003;</span> Status gudang dan pengiriman real-time</li>
        <li><span class="dot">&#10003;</span> Biaya all-in jelas sejak awal</li>
      </ul>
    </div>
    <p class="foot">Arenka Logistics &middot; China &rarr; Indonesia</p>
  </section>

  <section class="panel">
    <div class="card">
      <div class="logo-m">
        <svg height="34" viewBox="0 0 172 40" role="img" aria-label="Arenka Logistics">
          <path d="M3 35L16.5 5h7.4L37.4 35h-7.6L20.2 13.4 10.6 35z" fill="#002e62"/>
          <path d="M9.5 24.5h24.8l4.7 3.6-4.7 3.6H6.4z" fill="#d0f600"/>
          <text x="46" y="24" font-family="Inter,Arial,sans-serif" font-size="21" font-weight="800" letter-spacing="-.4" fill="#002e62">ARENKA</text>
          <text x="47" y="35.5" font-family="Inter,Arial,sans-serif" font-size="7.4" font-weight="650" letter-spacing="2.9" fill="#5a6b86">LOGISTICS</text>
        </svg>
      </div>
      <h1>Masuk ke Akun Arenka</h1>
      <p class="sub">Akses semua layanan, mulai dari Titip Beli hingga Titip Kirim, dalam satu platform yang aman dan mudah digunakan.</p>

      <button type="button" class="gbtn" id="google-btn">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Masuk dengan Google
      </button>

      <div class="divider">atau gunakan</div>

      <form id="login-form" novalidate>
        <label for="email">Email <span class="req">*</span></label>
        <div class="field">
          <input id="email" name="email" type="email" autocomplete="email" placeholder="contoh: nama@email.com" required />
        </div>
        <label for="password">Kata Sandi <span class="req">*</span></label>
        <div class="field">
          <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Kata sandi" required />
          <button type="button" class="toggle" id="pw-toggle" aria-label="Tampilkan kata sandi">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div class="row-end"><a href={waHref} target="_blank" rel="noopener">Lupa kata sandi?</a></div>
        <button type="submit" class="submit">Masuk</button>
      </form>

      <div class="notice" id="notice">
        Portal akun Arenka sedang kami siapkan. Anda bisa <a href="/dashboard">melihat pratinjau dashboard &rarr;</a> sekarang, atau akses pesanan dibantu langsung oleh tim kami &mdash;
        <a href={waHref} target="_blank" rel="noopener">hubungi via WhatsApp &rarr;</a>
      </div>

      <p class="alt">Belum punya akun Arenka? <a href={waHref} target="_blank" rel="noopener">Daftar Sekarang</a></p>
      <p class="back"><a href="/">&larr; Kembali ke beranda</a></p>
    </div>
  </section>
</main>

<script>
  var pw = document.getElementById("password");
  var tog = document.getElementById("pw-toggle");
  tog.addEventListener("click", function () {
    var show = pw.type === "password";
    pw.type = show ? "text" : "password";
    tog.setAttribute("aria-label", show ? "Sembunyikan kata sandi" : "Tampilkan kata sandi");
  });
  var notice = document.getElementById("notice");
  function reveal() { notice.classList.add("show"); }
  document.getElementById("login-form").addEventListener("submit", function (e) {
    e.preventDefault();
    reveal();
  });
  document.getElementById("google-btn").addEventListener("click", reveal);
</script>
</body>
</html>
