---
import { env } from "cloudflare:workers";
import { cookieNames, verifySessionToken } from "../../lib/auth";
const siteUrl = "https://arenkalogistics.com/dashboard/titip-beli";
const enabled = env.INDEXING_ENABLED === "true";
const wa = "6285216002219";
const waHref = "https://wa.me/" + wa + "?text=" + encodeURIComponent("Halo Arenka, saya mau Titip Beli barang dari China.");
const sessionUser = await verifySessionToken(Astro.cookies.get(cookieNames.session)?.value);
if (!sessionUser) {
  return Astro.redirect("/masuk", 302);
}
const fullName = sessionUser.name || sessionUser.email;
const firstName = (sessionUser.name || "").split(/\s+/)[0] || "Member";
const initialsStr =
  ((fullName.split(/\s+/)[0]?.[0] || "") + (fullName.split(/\s+/)[1]?.[0] || fullName.split(/\s+/)[0]?.[1] || "")).toUpperCase() || "MA";
const steps = [
  { n: "01", t: "Cari Produk yang Anda Inginkan", d: "Telusuri produk dari supplier China lewat 1688, Alibaba, atau Taobao. Salin tautan produk atau kata kunci yang Anda mau." },
  { n: "02", t: "Ajukan Permintaan Harga", d: "Kirim tautan atau detail produk ke tim Arenka. Kami bantu negosiasi dan konfirmasi ke penjual soal detail, dimensi, dan berat barang." },
  { n: "03", t: "Dapatkan Estimasi Harga All-In", d: "Setelah data lengkap, kami tampilkan harga all-in (sudah termasuk ongkir internasional, pajak, dan biaya layanan) agar anggaran jelas sejak awal." },
  { n: "04", t: "Checkout & Pembayaran", d: "Setelah Anda setuju, kami proses pembelian dan pembayaran ke penjual, lalu kabari status pengirimannya sampai tiba di alamat Anda." },
];
const adv = [
  { t: "Tim Lokal di China", d: "Tim kami di China membantu komunikasi dan validasi produk langsung ke supplier." },
  { t: "Aman & Terpercaya", d: "Transaksi berjalan melalui proses Arenka yang jelas dan terpantau di setiap tahap." },
  { t: "Harga All-In Transparan", d: "Estimasi sudah termasuk ongkir, pajak, dan biaya layanan. Tanpa biaya tersembunyi." },
  { t: "Satu Pintu untuk Semua", d: "Dari pencarian produk, penawaran harga, pembayaran, hingga pengiriman — ditangani Arenka." },
];
const cats = [
  { group: "Gadget Pilihan", items: ["Laptop & Notebook", "PC & Gaming", "Headphone & Earphone", "Monitor"] },
  { group: "Kebutuhan Rumah", items: ["Peralatan Dapur", "Perabot Kamar", "Dekorasi Rumah", "Elektronik"] },
  { group: "Lifestyle & Olahraga", items: ["Peralatan Gym", "Olahraga Outdoor", "Mainan & Koleksi", "Sepeda & Aksesoris"] },
];
const faqs = [
  { q: "Apa perbedaan Titip Beli dan Titip Kirim?", a: "Titip Beli dipakai jika Anda ingin membeli barang dari China. Titip Kirim dipakai jika Anda sudah punya barang di China dan hanya butuh jasa pengirimannya." },
  { q: "Apakah saya bisa membeli dari 1688, Alibaba, atau Taobao?", a: "Bisa. Kirim saja tautan produknya, tim kami yang menghubungi penjual, membayar dalam Yuan, mengecek barang, lalu mengirimnya ke Indonesia." },
  { q: "Apakah harga yang ditampilkan sudah termasuk pajak dan ongkir?", a: "Ya. Estimasi yang kami berikan bersifat all-in — sudah termasuk ongkir internasional, pajak, dan biaya layanan." },
  { q: "Berapa lama waktu pengiriman setelah pembelian?", a: "Tergantung jalur (laut/udara) dan jenis barang. Estimasi waktu kami sampaikan bersamaan dengan penawaran harga." },
  { q: "Bagaimana jika barang tidak sesuai atau rusak?", a: "Laporkan ke tim kami dengan foto dan detail pesanan. Kami bantu tindak lanjut sesuai kondisi dan kebijakan yang berlaku." },
  { q: "Bagaimana cara melacak status pembelian saya?", a: "Status pembelian dan pengiriman dapat Anda pantau melalui dashboard akun serta update dari tim kami via WhatsApp." },
];
---
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>Titip Beli | Dashboard Arenka Logistics</title>
<meta name="description" content="Titip Beli barang dari China bersama Arenka Logistics: kirim tautan produk dari 1688/Alibaba/Taobao, dapatkan harga all-in transparan, dan barang diantar sampai alamat Anda." />
<link rel="canonical" href={siteUrl} />
<meta name="robots" content={enabled ? "noindex,follow" : "noindex"} />
<meta name="theme-color" content="#002e62" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" />
<style>
:root{
  --heritage:#002e62;--heritage-2:#0b4589;--heritage-deep:#001b3a;
  --lime:#d0f600;--lime-edge:#a9c700;--ink:#17294a;--muted:#5a6b86;
  --soft:#eef3f9;--soft-2:#e2eaf5;--line:#d4deeb;--white:#fff;
  --font:"Inter","Segoe UI",Arial,sans-serif;--radius:16px;
  --shadow:0 10px 30px rgba(0,27,58,.07);color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;font:400 15px/1.6 var(--font);color:var(--ink);background:var(--soft);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
svg{display:block}
.ic{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.nav{position:sticky;top:0;z-index:40;background:var(--white);border-bottom:1px solid var(--line)}
.nav-top{display:flex;align-items:center;gap:18px;justify-content:flex-end;padding:7px 24px;border-bottom:1px solid var(--soft-2);font-size:13px;color:var(--muted);flex-wrap:wrap}
.nav-top .kurs{margin-right:auto;font-weight:600;color:var(--heritage)}
.nav-top a:hover{color:var(--heritage)}
.nav-main{display:flex;align-items:center;gap:22px;padding:12px 24px}
.nav-main .links{display:flex;gap:20px;align-items:center;margin-left:8px}
.nav-main .links a{font-weight:600;color:var(--ink);padding:6px 2px;border-bottom:2px solid transparent}
.nav-main .links a.active{color:var(--heritage);border-color:var(--lime)}
.nav-main .links a:hover{color:var(--heritage)}
.nav-main .right{margin-left:auto;display:flex;align-items:center;gap:16px}
.icon-btn{position:relative;width:38px;height:38px;border-radius:50%;border:1px solid var(--line);background:var(--white);display:grid;place-items:center;color:var(--heritage);font-size:18px;cursor:pointer}
.user{display:flex;align-items:center;gap:9px;padding:5px 12px 5px 6px;border:1px solid var(--line);border-radius:999px;background:var(--white)}
.user .av{width:30px;height:30px;border-radius:50%;background:var(--heritage);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px}
.user span{font-weight:600;font-size:14px}
.wrap{max-width:1100px;margin:0 auto;padding:0 24px}
.badge{display:inline-flex;align-items:center;gap:8px;background:var(--lime);color:var(--heritage);font-weight:800;font-size:12px;letter-spacing:.6px;text-transform:uppercase;padding:6px 12px;border-radius:999px}
/* hero */
.hero{background:linear-gradient(160deg,var(--heritage) 0%,var(--heritage-deep) 100%);color:#fff;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-140px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(208,246,0,.18),transparent 65%)}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center;padding-top:44px;padding-bottom:44px}
.hero h1{margin:16px 0 14px;font-size:clamp(26px,3.4vw,40px);line-height:1.12;font-weight:800;letter-spacing:-.5px}
.hero p{margin:0 0 22px;color:#c3d0e2;max-width:52ch}
.hero .cta{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;padding:12px 18px;border-radius:12px;border:1px solid transparent;cursor:pointer;font-size:15px}
.btn-lime{background:var(--lime);color:var(--heritage)}
.btn-lime:hover{background:#e2ff33}
.btn-ghost{background:transparent;border-color:rgba(255,255,255,.35);color:#fff}
.btn-ghost:hover{border-color:#fff}
.btn-blue{background:var(--heritage);color:#fff}
.btn-blue:hover{background:#013a7d}
.hero-art{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:22px;display:grid;gap:12px}
.hero-art .row{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.06);border-radius:12px;padding:12px 14px}
.hero-art .row .d{width:38px;height:38px;flex:none;border-radius:10px;background:var(--lime);color:var(--heritage);display:grid;place-items:center;font-weight:800}
.hero-art .row b{display:block;font-size:14px}
.hero-art .row small{color:#aebfd6}
/* sections */
section{padding:48px 0}
.sec-head{text-align:center;max-width:720px;margin:0 auto 30px}
.sec-head h2{margin:0 0 8px;font-size:clamp(21px,2.6vw,28px);font-weight:800;color:var(--heritage);letter-spacing:-.3px}
.sec-head p{margin:0;color:var(--muted)}
.search{background:var(--white)}
.search .box{max-width:720px;margin:0 auto;display:flex;gap:10px}
.search input{flex:1;padding:14px 16px;border:1px solid var(--line);border-radius:12px;font:400 15px var(--font)}
.search input:focus{outline:none;border-color:var(--heritage-2);box-shadow:0 0 0 3px rgba(11,69,137,.14)}
.about{background:var(--soft)}
.about .grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:900px;margin:22px auto 0}
.about .pt{display:flex;gap:12px;align-items:flex-start;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:16px}
.about .pt .i{flex:none;width:36px;height:36px;border-radius:10px;background:var(--soft);color:var(--heritage);display:grid;place-items:center;font-size:18px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.step{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
.step .n{font-size:30px;font-weight:800;color:var(--lime-edge);line-height:1}
.step h3{margin:10px 0 6px;font-size:16px;color:var(--heritage)}
.step p{margin:0;color:var(--muted);font-size:14px}
.adv-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.adv{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
.adv .i{width:40px;height:40px;border-radius:11px;background:var(--heritage);color:var(--lime);display:grid;place-items:center;font-size:19px;margin-bottom:12px}
.adv h3{margin:0 0 6px;font-size:15.5px;color:var(--heritage)}
.adv p{margin:0;color:var(--muted);font-size:13.5px}
.cats .grp{margin-top:22px}
.cats .grp h3{font-size:16px;color:var(--heritage);margin:0 0 12px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{display:inline-flex;align-items:center;gap:7px;background:var(--white);border:1px solid var(--line);border-radius:999px;padding:9px 15px;font-weight:600;font-size:14px;color:var(--heritage)}
.chip:hover{border-color:var(--heritage-2);background:#f6f9fd}
.cross{background:var(--heritage);color:#fff}
.cross .wrap{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}
.cross h2{margin:0 0 8px;font-size:24px;font-weight:800}
.cross p{margin:0;color:#c3d0e2;max-width:60ch}
.faq{max-width:820px;margin:0 auto}
details{background:var(--white);border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
summary{cursor:pointer;list-style:none;padding:16px 18px;font-weight:700;color:var(--heritage);display:flex;justify-content:space-between;gap:12px;align-items:center}
summary::-webkit-details-marker{display:none}
summary .pm{flex:none;width:22px;height:22px;border-radius:50%;background:var(--soft);color:var(--heritage);display:grid;place-items:center;font-size:16px;font-weight:800}
details[open] summary .pm{background:var(--lime)}
details p{margin:0;padding:0 18px 16px;color:var(--muted)}
.wa{position:fixed;right:20px;bottom:20px;z-index:50;display:inline-flex;align-items:center;gap:8px;background:#25D366;color:#fff;font-weight:700;padding:12px 16px;border-radius:999px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
.foot{text-align:center;color:var(--muted);font-size:13px;padding:22px}
@media (max-width:1000px){ .steps,.adv-grid{grid-template-columns:repeat(2,1fr)} .hero .wrap{grid-template-columns:1fr} .hero-art{order:-1} }
@media (max-width:720px){ .nav-main .links{display:none} .user span{display:none} .about .grid{grid-template-columns:1fr} .cross .wrap{grid-template-columns:1fr} .nav-top{justify-content:center} .nav-top .kurs{width:100%;text-align:center;margin-right:0} }
@media (max-width:460px){ .steps,.adv-grid{grid-template-columns:1fr} }
</style>
</head>
<body>
<header class="nav">
  <div class="nav-top">
    <span class="kurs">Kurs hari ini &yen;1 = Rp <b data-kurs>&mdash;</b></span>
    <a href="/#tentang">Tentang Kami</a>
    <a href="/#cara-kerja">Cara Belanja</a>
    <a href={waHref} target="_blank" rel="noopener">Kalkulator</a>
    <a href="/#kontak">Pusat Bantuan</a>
  </div>
  <div class="nav-main">
    <a href="/" aria-label="Arenka, beranda">
      <svg height="30" viewBox="0 0 172 40" role="img" aria-label="Arenka Logistics">
        <path d="M3 35L16.5 5h7.4L37.4 35h-7.6L20.2 13.4 10.6 35z" fill="#002e62"/>
        <path d="M9.5 24.5h24.8l4.7 3.6-4.7 3.6H6.4z" fill="#d0f600"/>
        <text x="46" y="24" font-family="Inter,Arial,sans-serif" font-size="21" font-weight="800" letter-spacing="-.4" fill="#002e62">ARENKA</text>
        <text x="47" y="35.5" font-family="Inter,Arial,sans-serif" font-size="7.4" font-weight="650" letter-spacing="2.9" fill="#5a6b86">LOGISTICS</text>
      </svg>
    </a>
    <nav class="links">
      <a href="/dashboard">Dashboard</a>
      <a href="/dashboard/titip-beli" class="active">Titip Beli</a>
      <a href="/#titip-kirim">Titip Kirim</a>
      <a href="/posts">Artikel</a>
    </nav>
    <div class="right">
      <span class="user"><span class="av">{initialsStr}</span><span>Hai, {firstName}</span></span>
      <a class="icon-btn" href="/api/auth/logout" aria-label="Keluar" title="Keluar"><svg class="ic" viewBox="0 0 24 24" style="font-size:18px"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg></a>
    </div>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div>
      <span class="badge"><svg class="ic" viewBox="0 0 24 24" style="font-size:14px"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg> Titip Beli</span>
      <h1>Titip Beli Barang dari China dengan Proses yang Praktis &amp; Transparan</h1>
      <p>Temukan produk langsung dari supplier China dan biarkan Arenka mengurus seluruh prosesnya — mulai dari komunikasi supplier, perhitungan harga, pembayaran dalam Yuan, hingga pengiriman sampai alamat Anda di Indonesia.</p>
      <div class="cta">
        <a class="btn btn-lime" href={waHref} target="_blank" rel="noopener">Kirim Link Produk via WhatsApp</a>
        <a class="btn btn-ghost" href="#cara-kerja">Pelajari Cara Kerja</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="row"><span class="d">1688</span><span><b>1688.com</b><small>Grosir pabrik China</small></span></div>
      <div class="row"><span class="d">T</span><span><b>Taobao</b><small>Ritel &amp; produk unik</small></span></div>
      <div class="row"><span class="d">A</span><span><b>Alibaba</b><small>Supplier &amp; OEM/ODM</small></span></div>
    </div>
  </div>
</section>

<section class="search">
  <div class="wrap">
    <div class="sec-head"><h2>Temukan Supplier &amp; Referensi Produk dari China</h2><p>Tempel tautan produk dari 1688, Alibaba, atau Taobao — atau ketik kata kunci. Kami bantu carikan dan hitung harga all-in.</p></div>
    <div class="box">
      <input id="q" type="text" placeholder="Contoh: tas ransel kulit, atau tempel link 1688/Taobao" aria-label="Kata kunci atau link produk" />
      <button class="btn btn-blue" id="q-send" type="button">Kirim ke WhatsApp</button>
    </div>
  </div>
</section>

<section class="about">
  <div class="wrap">
    <div class="sec-head"><h2>Tentang Layanan Titip Beli</h2><p>Dirancang agar Anda bisa membeli produk dari supplier, pabrik, atau marketplace China tanpa perlu akun lokal, bahasa Mandarin, atau mengurus pengiriman internasional yang rumit.</p></div>
    <div class="grid">
      <div class="pt"><span class="i"><svg class="ic" viewBox="0 0 24 24" style="font-size:18px"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg></span><span>Beli langsung dari supplier atau marketplace China terpercaya.</span></div>
      <div class="pt"><span class="i"><svg class="ic" viewBox="0 0 24 24" style="font-size:18px"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9"/></svg></span><span>Tim lokal Arenka bantu komunikasi dan validasi produk.</span></div>
      <div class="pt"><span class="i"><svg class="ic" viewBox="0 0 24 24" style="font-size:18px"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><span>Harga ditampilkan all-in: ongkir, pajak, dan biaya layanan.</span></div>
      <div class="pt"><span class="i"><svg class="ic" viewBox="0 0 24 24" style="font-size:18px"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg></span><span>Barang dikirim langsung ke alamat Anda di Indonesia.</span></div>
    </div>
  </div>
</section>

<section id="cara-kerja">
  <div class="wrap">
    <div class="sec-head"><h2>Cara Kerja Titip Beli di Arenka</h2><p>Belanja produk luar negeri semudah di marketplace biasa, tanpa repot mengurus pengiriman internasional.</p></div>
    <div class="steps">
      {steps.map((s) => (
        <div class="step"><div class="n">{s.n}</div><h3>{s.t}</h3><p>{s.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="about">
  <div class="wrap">
    <div class="sec-head"><h2>Keunggulan Layanan Titip Beli Arenka</h2></div>
    <div class="adv-grid">
      {adv.map((a) => (
        <div class="adv"><div class="i"><svg class="ic" viewBox="0 0 24 24" style="font-size:19px"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="m9 11 3 3L22 4"/></svg></div><h3>{a.t}</h3><p>{a.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="cats">
  <div class="wrap">
    <div class="sec-head"><h2>Rekomendasi Kategori</h2><p>Butuh ide? Mulai dari kategori populer berikut, lalu kirim ke kami untuk dihitung harga all-in-nya.</p></div>
    {cats.map((c) => (
      <div class="grp">
        <h3>{c.group}</h3>
        <div class="chips">
          {c.items.map((it) => (
            <a class="chip" href={"https://wa.me/" + wa + "?text=" + encodeURIComponent("Halo Arenka, saya mau Titip Beli kategori: " + it)} target="_blank" rel="noopener">{it}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="cross">
  <div class="wrap">
    <div>
      <h2>Sudah Punya Barang di China?</h2>
      <p>Serahkan proses pengirimannya ke Arenka. Layanan Titip Kirim membawa barang Anda dari gudang di China sampai alamat tujuan di Indonesia — aman, efisien, dan legal.</p>
    </div>
    <a class="btn btn-lime" href="/#titip-kirim">Pelajari Titip Kirim</a>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><h2>Pertanyaan Umum Seputar Titip Beli</h2></div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}<span class="pm">+</span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
