---
import {
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { optimizedArticleImages } from "../../utils/article-images";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

const siteUrl = Astro.url.origin;
const pageUrl = siteUrl + Astro.url.pathname.replace(/\/$/, "");
const authorName = "Tim Arenka";
const optimizedImage = optimizedArticleImages[slug];

// Document title: keep it short enough for search results. Long article titles
// stand alone; the site name is only appended when it fits and is not already there.
const rawSeo = ((post as any).seo ?? (post.data as any).seo ?? {}) as { title?: string | null };
const pageTitle = (rawSeo.title || post.data.title || "").trim();
const docTitle =
	/arenka/i.test(pageTitle) || pageTitle.length + siteTitle.length + 3 > 62
		? pageTitle
		: `${pageTitle} | ${siteTitle}`;

// Preview image: the SEO image field can hold a bare media id, which the media
// endpoint cannot serve (404). Only trust it when it points at an image file;
// otherwise use the featured image, then the site-wide preview image.
const IMAGE_FILE_RE = /\.(png|jpe?g|webp|gif|avif)(\?|$)/i;
const featured = post.data.featured_image as
	| { src?: string; alt?: string; meta?: { storageKey?: string } }
	| undefined;
const featuredUrl = featured?.meta?.storageKey
	? `${siteUrl}/_emdash/api/media/file/${featured.meta.storageKey}`
	: featured?.src
		? new URL(featured.src, siteUrl).href
		: null;
const ogImage =
	(optimizedImage ? new URL(optimizedImage.src, siteUrl).href : null) ||
	(seo.ogImage && IMAGE_FILE_RE.test(seo.ogImage) ? seo.ogImage : null) ||
	featuredUrl ||
	`${siteUrl}/assets/img/og-arenka.jpg`;

const publishedIso = post.data.publishedAt
	? post.data.publishedAt.toISOString()
	: undefined;
const modifiedAt = (post.data as any).updatedAt;
const modifiedIso =
	modifiedAt && typeof modifiedAt.toISOString === "function"
		? modifiedAt.toISOString()
		: publishedIso;
const showUpdated =
	publishedIso && modifiedIso && modifiedIso.slice(0, 10) !== publishedIso.slice(0, 10);
const formatDate = (iso: string) =>
	new Date(iso).toLocaleDateString("id-ID", { year: "numeric", month: "long", day: "numeric" });

// BlogPosting JSON-LD comes from EmDashHead (it receives articleMeta via Base).
// Only the breadcrumb is added here, so each page carries one BlogPosting.
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Beranda", item: siteUrl + "/" },
		{ "@type": "ListItem", position: 2, name: "Artikel", item: siteUrl + "/posts" },
		{ "@type": "ListItem", position: 3, name: post.data.title, item: pageUrl },
	],
};

// Related articles in Indonesian (replaces the starter's English sidebar widgets).
const { entries: latest } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 5,
});
const related = latest.filter((p) => p.id !== post.id).slice(0, 4);
---

<Base
	title={docTitle}
	rawTitle
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={ogImage}
	pageType="article"
	articleMeta={{ publishedTime: publishedIso, modifiedTime: modifiedIso }}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
	<article>
		{
			post.data.featured_image && (
				<div {...post.edit.featured_image}>
					{optimizedImage ? (
						<img src={optimizedImage.src} alt={optimizedImage.alt} width={optimizedImage.width} height={optimizedImage.height} fetchpriority="high" decoding="async" />
					) : (
						<Image image={post.data.featured_image} priority />
					)}
				</div>
			)
		}

		<h1 {...post.edit.title}>{post.data.title}</h1>

		{
			publishedIso && (
				<time datetime={publishedIso}>{formatDate(publishedIso)}</time>
			)
		}
		{
			showUpdated && modifiedIso && (
				<span class="updated">
					· Diperbarui <time datetime={modifiedIso}>{formatDate(modifiedIso)}</time>
				</span>
			)
		}

		<p class="byline">Oleh {authorName}</p>

		{
			categories.length > 0 && (
				<div class="terms">
					{categories.map((c) => (
						<a href={`/category/${c.slug}`}>{c.label}</a>
					))}
				</div>
			)
		}

		<PortableText value={post.data.content} />

		{
			tags.length > 0 && (
				<div class="terms">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`}>{t.label}</a>
					))}
				</div>
			)
		}
	</article>

	{
		related.length > 0 && (
			<aside class="related" aria-labelledby="related-title">
				<h2 id="related-title">Artikel lainnya</h2>
				<ul>
					{related.map((p) => (
						<li>
							<a href={`/posts/${p.id}`}>{p.data.title}</a>
							{p.data.publishedAt && (
								<time datetime={p.data.publishedAt.toISOString()}>
									{formatDate(p.data.publishedAt.toISOString())}
								</time>
							)}
						</li>
					))}
				</ul>
			</aside>
		)
	}
</Base>
