      </a>
      <p class="cta-note">
        Atau hitung dulu volume kirimannya di <a href="/kalkulator-cbm">kalkulator CBM</a> kami.
      </p>
    </div>

    <h2 id="faq">Pertanyaan yang sering diajukan</h2>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
