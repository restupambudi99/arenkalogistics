---
import Base from "../../layouts/Base.astro";

// Artikel SEO/GEO/AEO. Halaman statis (route sendiri) karena isi artikel CMS
// tersimpan di database EmDash, sementara artikel ini perlu kontrol penuh atas
// JSON-LD, ilustrasi SVG inline dan CTA WhatsApp.
const siteUrl = "https://arenkalogistics.com";
const path = "/posts/cara-mencari-supplier-tangan-pertama-1688";
const pageUrl = siteUrl + path;

const title = "Cara Mencari Supplier Tangan Pertama di 1688 dan Pabrik China";
const description =
  "Panduan verifikasi supplier tangan pertama di 1688: baca label pabrik, cek izin usaha di sistem resmi pemerintah China, dan bedakan pabrik dari trading company.";
const published = "2026-11-23";
const modified = "2026-11-23";
const author = "Tim Arenka";
const ogImage = siteUrl + "/assets/img/og-arenka.jpg";

const waNumber = "6285216002219";
const waGreeting =
  "Saya berminat cara mencari supplier 1688 langsung dan mencari supplier tangan pertama tanpa perantara";
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(waGreeting)}`;

const faq = [
  {
    q: "Apa itu supplier tangan pertama di 1688?",
    a: "Supplier tangan pertama adalah pabrik yang memproduksi sendiri barangnya, bukan pedagang yang mengambil dari pabrik lain. Di 1688 istilahnya 源头工厂 (yuantou gongchang, pabrik sumber). Tandanya bisa diverifikasi: izin usaha memuat kata 生产 (produksi) atau 制造 (manufaktur), ada label verifikasi pabrik dari platform, dan pihak supplier mampu menunjukkan lini produksinya lewat video langsung. Menurut data platform 1688, pabrik yang lolos sertifikasi sumber punya tingkat sengketa 67% lebih rendah dibanding supplier tanpa sertifikasi.",
  },
  {
    q: "Bagaimana cara membedakan pabrik dan trading company di 1688?",
    a: "Mulai dari nama perusahaan. Nama yang memuat 厂 (pabrik), 制造 (manufaktur), atau 实业 (industri) cenderung dekat ke produksi. Nama yang memuat 贸易有限公司 (trading co), 电子商务 (e-commerce), atau 百货商行 (toko serba ada) umumnya perantara. Lalu cocokkan dengan izin usaha di sistem resmi pemerintah China (gsxt.gov.cn): kolom 经营范围 (ruang lingkup usaha) pabrik asli memuat kata produksi atau manufaktur, bukan hanya penjualan grosir.",
  },
  {
    q: "Apakah harga di 1688 selalu lebih murah daripada Alibaba.com?",
    a: "Umumnya ya, karena 1688 adalah pasar grosir domestik China, sementara Alibaba.com adalah pasar ekspor dengan lapisan biaya tambahan. Alibaba Group menyebut 1688 sebagai sumber produk bagi e-commerce China. Tapi harga rendah di 1688 tidak otomatis berarti harga pabrik: perantara juga berjualan di 1688, dan margin mereka sudah menempel di harga yang Anda lihat.",
  },
  {
    q: "Berapa MOQ supplier tangan pertama di 1688?",
    a: "Bervariasi per kategori. Banyak listing 1688 bisa dibeli 1 sampai 2 unit untuk sampel, tapi harga pabrik biasanya baru keluar di kuantitas tertentu. Pabrik asli hampir selalu punya MOQ. Klaim pabrik langsung tanpa MOQ justru patut dicurigai, karena itu pola khas pedagang yang menyetok barang orang lain.",
  },
  {
    q: "Apa risiko terbesar membeli langsung dari pabrik China tanpa perantara?",
    a: "Tiga risiko utama. Pertama, salah identitas: yang Anda kira pabrik ternyata pedagang, sehingga tidak ada kendali atas kualitas produksi. Kedua, pembayaran: pabrik domestik China hanya menerima pembayaran dalam Yuan melalui rekening perusahaan, dan transfer ke rekening pribadi adalah pola penipuan paling umum. Ketiga, kepabeanan: barang yang masuk daftar Larangan dan Pembatasan (LARTAS) bisa tertahan di Bea dan Cukai jika izinnya tidak lengkap.",
  },
  {
    q: "Apakah barang dari 1688 kena bea masuk di Indonesia?",
    a: "Ya, bea masuk, PPN dan PPh impor mengikuti kode HS barang. Besaran tarif dan status Larangan dan Pembatasan (LARTAS) untuk setiap kode HS bisa dicek sendiri di portal Indonesia National Single Window (insw.go.id). Cek kode HS sebelum memesan, bukan setelah barang berangkat.",
  },
  {
    q: "Apakah perlu bisa bahasa Mandarin untuk cari supplier di 1688?",
    a: "Untuk mencari, tidak wajib. Tapi kata kunci Mandarin menentukan hasil pencarian, karena mesin pencari 1688 mengindeks judul produk berbahasa Mandarin. Untuk negosiasi harga pabrik dan membaca izin usaha, kemampuan Mandarin berpengaruh besar pada harga akhir yang Anda dapat.",
  },
];

