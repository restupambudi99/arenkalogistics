{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arenka-logistics",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"EMDASH_SITE_URL": "https://arenkalogistics.com",
		"INDEXING_ENABLED": "true",
	},
	"routes": [
		{ "pattern": "arenkalogistics.com", "custom_domain": true },
		{ "pattern": "www.arenkalogistics.com", "custom_domain": true },
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arenka-logistics",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "arenka-logistics-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "4e04dd6611ce4e7b9534b9d0ea8f985d",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
